# Builds the AdsCutter release tagged v$pkgver in the git repository this
# PKGBUILD lives in. To build from the server instead, set _repo to the
# remote URL, e.g. git+ssh://forgejo@git.beniamino.eu:21022/benji/adscutter.git
#
#   cd packaging/arch && makepkg -si
#
# For a new release: set the version in meson.build, commit, tag it
# vX.Y.Z, then set pkgver here (pkgrel back to 1) and refresh
# sha256sums with makepkg -g.

pkgname=adscutter
pkgver=0.1.1
pkgrel=1
pkgdesc='Cut ads out of DVB-T/T2 TV recordings without re-encoding'
arch=('x86_64')
url='https://github.com/mbeniamino/adscutter'
license=('MIT')
depends=(
  'ffmpeg>=2:7'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-multimedia'
)
optdepends=(
  'qt6-svg: application icon on X11 and in the About box'
  'vulkan-driver: Vulkan video decoding'
  'libva-driver: VAAPI video decoding'
)
makedepends=('git' 'meson')
checkdepends=('desktop-file-utils' 'python')

_repo="git+file://$(realpath "${startdir:-.}/../..")"
source=("$pkgname::$_repo#tag=v$pkgver")
sha256sums=('f4e5a380bd1a2489188f761e72c3e472754667a8a851387fd5b75c519131fd47')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

check() {
  # The hw suite tests the local GPU driver, not the package.
  meson test -C build --print-errorlogs --no-suite hw
}

package() {
  meson install -C build --destdir "$pkgdir"
  # MIT is not in Arch's common licenses, so the text must ship with the package.
  install -Dm644 "$pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
